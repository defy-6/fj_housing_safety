# 智能分析后端环境变量模板 —— 复制为 backend/.env 并按需填写
# 密钥绝不提交到代码库；uvicorn 启动后由 app/config.py 读取

# 模型密钥（LLM_MODEL_REGISTRY 中的 api_key_env 对应项）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 默认模型与超时（管线子进程环境注入用）
QWEN_MODEL=qwen3.6-plus
QWEN_TIMEOUT_SECONDS=210
QWEN_REPAIR_TIMEOUT_SECONDS=90
QWEN_MAX_RETRIES=0
QWEN_MAX_TOKENS=4096
QWEN_ENABLE_THINKING=0

# 服务监听
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
